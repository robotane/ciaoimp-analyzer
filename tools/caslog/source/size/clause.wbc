    put_unsafe_value(y(2),1),
    put_value(y(0),2),
    deallocate,
    execute((number_of_literals)/3)]).


clause(:-('$number_of_literals/3_$aux1'(A,B,C),','('$get_current_choice'(D),','(=(A,E),','('$cut'(D),','('$get_current_choice'(F),','(nonsequence(E),','('$cut'(F),=(C,B)))))))),[
    allocate(3),
    get_variable(y(0),1),
    get_variable(y(1),2),
    get_current_choice(x(1)),
    cut(x(1)),
    get_current_choice(y(2)),
    call((nonsequence)/1),
    cut(y(2)),
    put_value(y(1),0),
    get_value(y(0),0),
    deallocate,
    proceed]).
