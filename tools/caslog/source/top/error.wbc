predicate(error_message/3,10,static,private,monofile,global,1).


clause(:-(error_message(A,B,C),','(write('* Caslog error: '),','(error(A,B),','(nl,','(write('  '),','(write(C),nl)))))),[
    allocate(3),
    get_variable(y(0),0),
    get_variable(y(1),1),
    get_variable(y(2),2),
    put_atom('* Caslog error: ',0),
    call((write)/1),
    put_value(y(0),0),
    put_value(y(1),1),
    call((error)/2),
    call((nl)/0),
    put_atom('  ',0),
    call((write)/1),
    put_value(y(2),0),
    call((write)/1),
    deallocate,
    execute((nl)/0)]).


