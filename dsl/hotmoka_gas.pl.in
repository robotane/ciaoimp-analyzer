% Gas cost model of the Hotmoka primitives (hotmoka.pl), in Hotmoka gas units.
% GENERATED by pipeline/gen_model.py from data/constants_*.json: do not edit.
%
% Every contract of dsl/ loads this package; CiaoPP then gives
% each operation an upper bound in gas, to which the fixed cost of a
% transaction (c_tx) is added.

:- package(hotmoka_gas).
:- use_package(assertions).
:- use_package(nativeprops).
:- use_package(regtypes).
:- use_package(resdefs).

:- use_module(hotmoka).

% Implicit costs (field writes, payable methods): see hotmoka_tr.pl.
:- load_compilation_module(.(hotmoka_tr)).
:- add_sentence_trans(hotmoka_tr:tr/4, 600).

% Obj[field] := V (field of a storage object, see hotmoka_tr.pl).
:- set_prolog_flag(read_postfix_blocks, on).
:- op(40, yf, ['[]']).

% Typed collections and amounts (:- storage, :- amount, see hotmoka_tr.pl):
% M[K] := V, M[K] += A, M[K] -= A, X += A, X -= A.
:- op(980, xfx, ['+=', '-=']).

:- resource gas.
:- head_cost(ub, gas, @C_STEP@).
:- head_cost(lb, gas, @C_STEP@).
:- literal_cost(ub, gas, 0).
:- literal_cost(lb, gas, 0).
:- trust_default + cost(ub, gas, 0).

% --- Types ---

:- regtype balances/1.
balances([]).
balances([X|T]) :- balpair(X), balances(T).
:- regtype balpair/1.
balpair(bal(A, B)) :- atm(A), int(B).

:- regtype map/1.
map([]).
map([X|T]) :- kvpair(X), map(T).
:- regtype kvpair/1.
kvpair(kv(K, V)) :- gnd(K), gnd(V).

% --- Gas of the primitives ---
%
% Tree maps/sets (StorageTreeMap, SnapshottableStorageTreeMap/Set, StorageTreeSet): the
% C_TREE*, C_TREEW*, C_TREER*, C_TMP* constants are worst-case values derived from the
% instrumented Takamaka code (costmodel/tree/arbre_pire_cas.md): a left-leaning
% red-black tree of n keys has black height bh <= log2(n+1); a search path has <= 2*bh nodes;
% a put copies or modifies <= 2*bh+1 nodes, a remove <= 2*(2*bh+1). The slope of log2(n+1)
% therefore already holds the factor 2 of the height, whatever the order of the keys.

:- trust pred transfer(From, To, Amount, B0, B)
   => ( balances(B), size(lb, B, length(B0)), size(ub, B, length(B0)) )
   + ( not_fails, is_det, cost(lb, gas, @C_PAY@), cost(ub, gas, @C_PAY@) ).

:- trust pred balance(A, B, V)
   + ( not_fails, is_det, cost(lb, gas, @C_FIELD@), cost(ub, gas, @C_FIELD@) ).

% The value read in a ground map with a ground default is ground (the fields of an object
% read with Obj[f] are then known to the sharing analysis).
:- trust pred map_get(K, M, D, V) : (ground(M), ground(D)) => ground(V)
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREE0@+@C_TREE1@*log2(length(M)+1)),
       cost(ub, gas, @C_TREE0@+@C_TREE1@*log2(length(M)+1)) ).

:- trust pred map_put(K, V, M0, M)
   => ( map(M), size(lb, M, length(M0)), size(ub, M, length(M0)+1) )
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREEW0@+@C_TREEW1@*log2(length(M0)+1)),
       cost(ub, gas, @C_TREEW0@+@C_TREEW1@*log2(length(M0)+1)+@C_NEW@) ).

% The value of a key already in the map is an object that the Java mutates in place
% (paper.weight = 1, bids.removeFirst(), ...): no access to the tree. The writes of the
% fields of that object are counted where they are written (store, list_remove_first).
% map_set and list_set declare their result ground without condition: the state of a
% contract is ground data, and with a call condition CiaoPP does not use their size
% (the bound of ballot.vote became inf).
:- trust pred map_set(K, V, M0, M)
   => ( ground(M), map(M), size(lb, M, length(M0)), size(ub, M, length(M0)) )
   + ( not_fails, is_det, cost(lb, gas, 0), cost(ub, gas, 0) ).

% remove of a persistent (Snapshottable) tree: top-down moveRed* + balance on each level.
:- trust pred map_remove(K, M0, M)
   => ( map(M), size(lb, M, 0), size(ub, M, length(M0)) )
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREER0@+@C_TREER1@*log2(length(M0)+1)),
       cost(ub, gas, @C_TREER0@+@C_TREER1@*log2(length(M0)+1)) ).

% Temporary tree map/set (created in the transaction, never stored), e.g. the
% StorageTreeSet seen of Ballot.computeFinalDelegate.
:- trust pred tmp_get(K, M, D, V)
   + ( not_fails, is_det,
       cost(lb, gas, @C_TMP0@+@C_TMP1@*log2(length(M)+1)),
       cost(ub, gas, @C_TMP0@+@C_TMP1@*log2(length(M)+1)) ).

:- trust pred tmp_put(K, V, M0, M)
   => ( map(M), size(lb, M, length(M0)), size(ub, M, length(M0)+1) )
   + ( not_fails, is_det,
       cost(lb, gas, @C_TMP0@+@C_TMP1@*log2(length(M0)+1)),
       cost(ub, gas, @C_TMP0@+@C_TMP1@*log2(length(M0)+1)) ).

:- trust pred list_add(X, L0, L)
   => ( size(lb, L, length(L0)+1), size(ub, L, length(L0)+1) )
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

:- trust pred list_size(L, N)
   => ( size(lb, N, length(L)), size(ub, N, length(L)) )
   + ( not_fails, is_det, cost(lb, gas, @C_FIELD@), cost(ub, gas, @C_FIELD@) ).

% StorageLinkedList.removeFirst(): reads the head node (first.element, first.next) and writes
% the fields of the list: first and size, and last too when the list becomes empty.
:- trust pred list_remove_first(X, L0, L)
   => ( size(lb, L, length(L0)-1), size(ub, L, length(L0)-1) )
   + ( is_det, cost(lb, gas, @C_LOAD@+2*@C_STORE@), cost(ub, gas, @C_LOAD@+3*@C_STORE@) ).

% StorageLinkedList.get(i): reads the size field (index check), then walks from the head,
% one node per step, up to the node i (i+1 nodes, i < size). The element returned is a
% storage object of its own, loaded by its first field read (Obj[f]). Its groundness is a
% separate assertion: with the call condition on the cost assertion, the cost is not used.
:- trust pred list_get(I, L, X) : ground(L) => ground(X).
:- trust pred list_get(I, L, X)
   + ( is_det, cost(lb, gas, @C_FIELD@+@C_LOAD@), cost(ub, gas, @C_FIELD@+@C_LOAD@*length(L)) ).

% The element i is an object that the Java mutates in place: no access to the list
% (ground result: see map_set).
:- trust pred list_set(I, V, L0, L)
   => ( ground(L), list(L), size(lb, L, length(L0)), size(ub, L, length(L0)) )
   + ( not_fails, is_det, cost(lb, gas, 0), cost(ub, gas, 0) ).

:- trust pred arr_get(I, A, X)
   + ( not_fails, is_det, cost(lb, gas, @C_ARRR@), cost(ub, gas, @C_ARRR@) ).

:- trust pred arr_set(I, V, A0, A)
   => ( size(lb, A, length(A0)), size(ub, A, length(A0)) )
   + ( not_fails, is_det, cost(lb, gas, @C_ARR@), cost(ub, gas, @C_ARR@) ).

% UnsignedBigInteger.add/subtract: the result is a new storage object (the require of
% subtract, a non-negative result, is the test written before it in the contract).
:- trust pred ubi_add(A, B, C)
   => num(C)
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

:- trust pred ubi_sub(A, B, C)
   => num(C)
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

% --- BigIntegerSupport: gas by bit length (opt-in primitives of hotmoka.pl) ---
%
% Rule of io.takamaka.code.math.BigIntegerSupport (takamaka-code 1.8.1), read in the class file:
%   add, subtract, multiply, divide, mod, divideAndRemainder: gas for CPU += bl(a)+bl(b) and gas for
%   RAM += bl(a)+bl(b), in addition to the constant cost of the call (already in the constants);
%   compareTo, equals: CPU += bl(a)+bl(b) only.
% bl(x) = bitLength = floor(log2 x)+1 (0 for x = 0). The size of an integer is its value, and
%   log2(int(x)+1) <= bl(x) <= log2(int(x)+1)+1 for x >= 0: the upper bound uses log2(int(x)+1)+1, the lower
%   bound log2(int(x)+1). The cost of an arithmetic operation is 2*(bl(a)+bl(b)), that of a comparison
%   bl(a)+bl(b). The constant part of the call (C_*) is not repeated here.
% Contract.pay(payer, amount) = compareTo(payer.balance, amount) + subtract(payer.balance, amount)
%   + add(payee.balance, amount): 3*bl(payer.balance) + 2*bl(payee.balance) + 5*bl(amount).
%   big_pay(Paid, Held) charges 5*bl(Paid) + 3*bl(Held), Held being a bound of the payer balance
%   given by the contract (hypothesis written in the contract). The balance of the payee, and that
%   of a payer that is a user account, are those of the calibration of C_PAY (accounts of 10^15).
% The sizes of the results are those of the exact arithmetic (non-negative integers): A+B, A*B,
%   at most A for a difference or a quotient by B >= 1, below B for A mod B.

:- trust pred big_add(A, B, C)
   => ( int(C), size(lb, C, int(A)+int(B)), size(ub, C, int(A)+int(B)) )
   + ( not_fails, is_det,
       cost(lb, gas, 2*(log2(int(A)+1)+log2(int(B)+1))), cost(ub, gas, 2*(log2(int(A)+1)+log2(int(B)+1)+2)) ).

:- trust pred big_sub(A, B, C)
   => ( int(C), size(lb, C, 0), size(ub, C, int(A)) )
   + ( is_det,
       cost(lb, gas, 2*(log2(int(A)+1)+log2(int(B)+1))), cost(ub, gas, 2*(log2(int(A)+1)+log2(int(B)+1)+2)) ).

:- trust pred big_mul(A, B, C)
   => ( int(C), size(lb, C, int(A)*int(B)), size(ub, C, int(A)*int(B)) )
   + ( not_fails, is_det,
       cost(lb, gas, 2*(log2(int(A)+1)+log2(int(B)+1))), cost(ub, gas, 2*(log2(int(A)+1)+log2(int(B)+1)+2)) ).

:- trust pred big_div(A, B, C)
   => ( int(C), size(lb, C, 0), size(ub, C, int(A)) )
   + ( is_det,
       cost(lb, gas, 2*(log2(int(A)+1)+log2(int(B)+1))), cost(ub, gas, 2*(log2(int(A)+1)+log2(int(B)+1)+2)) ).

:- trust pred big_mod(A, B, C)
   => ( int(C), size(lb, C, 0), size(ub, C, int(B)) )
   + ( is_det,
       cost(lb, gas, 2*(log2(int(A)+1)+log2(int(B)+1))), cost(ub, gas, 2*(log2(int(A)+1)+log2(int(B)+1)+2)) ).

:- trust pred big_gt(A, B)
   + ( is_det,
       cost(lb, gas, log2(int(A)+1)+log2(int(B)+1)), cost(ub, gas, log2(int(A)+1)+log2(int(B)+1)+2) ).

:- trust pred big_ge(A, B)
   + ( is_det,
       cost(lb, gas, log2(int(A)+1)+log2(int(B)+1)), cost(ub, gas, log2(int(A)+1)+log2(int(B)+1)+2) ).

% A payer holds at least what it pays: bl(payer.balance) >= bl(Paid), whence the lower bound.
:- trust pred big_pay(Paid, Held)
   + ( not_fails, is_det,
       cost(lb, gas, 8*log2(int(Paid)+1)), cost(ub, gas, 5*(log2(int(Paid)+1)+1)+3*(log2(int(Held)+1)+1)) ).

% snapshot() of a Snapshottable map/set: a new view object.
:- trust pred snapshot(M, S)
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

% Bytes32Snapshot.toArray(): reads the storage object.
:- trust pred to_array(X, A)
   + ( not_fails, is_det, cost(lb, gas, @C_LOAD@), cost(ub, gas, @C_LOAD@) ).

:- trust pred load(X)
   + ( not_fails, is_det, cost(lb, gas, @C_LOAD@), cost(ub, gas, @C_LOAD@) ).

:- trust pred new_obj(X)
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

:- trust pred store(X)
   + ( not_fails, is_det, cost(lb, gas, @C_STORE@), cost(ub, gas, @C_STORE@) ).

:- trust pred emit(X)
   + ( not_fails, is_det, cost(lb, gas, @C_EVENT@), cost(ub, gas, @C_EVENT@) ).
