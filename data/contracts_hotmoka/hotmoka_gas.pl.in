% Gas cost model of the Hotmoka primitives (hotmoka.pl), in Hotmoka gas units.
% GENERATED by hotmoka-bench/costmodel/gen_model.py from constants.json: do not edit.
%
% Every contract of data/contracts_hotmoka loads this package; CiaoPP then gives
% each operation an upper bound in gas, to which the fixed cost of a
% transaction (c_tx) is added.

:- package(hotmoka_gas).
:- use_package(assertions).
:- use_package(nativeprops).
:- use_package(regtypes).
:- use_package(resdefs).

:- use_module(hotmoka).

:- resource gas.
:- head_cost(ub, gas, @C_STEP@).
:- head_cost(lb, gas, @C_STEP@).
:- literal_cost(ub, gas, 0).
:- literal_cost(lb, gas, 0).
:- trust_default + cost(ub, gas, 0).

% --- Types ---

:- regtype balances/1.
balances([]).
balances([X|T]) :- balpair(X), balances(T).
:- regtype balpair/1.
balpair(bal(A, B)) :- atm(A), int(B).

:- regtype map/1.
map([]).
map([X|T]) :- kvpair(X), map(T).
:- regtype kvpair/1.
kvpair(kv(K, V)) :- gnd(K), gnd(V).

% --- Gas of the primitives ---

:- trust pred transfer(From, To, Amount, B0, B)
   => ( balances(B), size(lb, B, length(B0)), size(ub, B, length(B0)) )
   + ( not_fails, is_det, cost(lb, gas, @C_PAY@), cost(ub, gas, @C_PAY@) ).

:- trust pred balance(A, B, V)
   + ( not_fails, is_det, cost(lb, gas, @C_FIELD@), cost(ub, gas, @C_FIELD@) ).

:- trust pred map_get(K, M, D, V)
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREE0@+@C_TREE1@*log2(length(M)+1)),
       cost(ub, gas, @C_TREE0@+@C_TREE1@*log2(length(M)+1)) ).

:- trust pred map_put(K, V, M0, M)
   => ( map(M), size(lb, M, length(M0)), size(ub, M, length(M0)+1) )
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREE0@+@C_TREE1@*log2(length(M0)+1)),
       cost(ub, gas, @C_TREE0@+@C_TREE1@*log2(length(M0)+1)+@C_NEW@) ).

:- trust pred map_remove(K, M0, M)
   => ( map(M), size(lb, M, 0), size(ub, M, length(M0)) )
   + ( not_fails, is_det,
       cost(lb, gas, @C_TREE0@+@C_TREE1@*log2(length(M0)+1)),
       cost(ub, gas, @C_TREE0@+@C_TREE1@*log2(length(M0)+1)) ).

:- trust pred list_add(X, L0, L)
   => ( size(lb, L, length(L0)+1), size(ub, L, length(L0)+1) )
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

:- trust pred arr_get(I, A, X)
   + ( not_fails, is_det, cost(lb, gas, @C_ARR@), cost(ub, gas, @C_ARR@) ).

:- trust pred arr_set(I, V, A0, A)
   => ( size(lb, A, length(A0)), size(ub, A, length(A0)) )
   + ( not_fails, is_det, cost(lb, gas, @C_ARR@), cost(ub, gas, @C_ARR@) ).

:- trust pred load(X)
   + ( not_fails, is_det, cost(lb, gas, @C_LOAD@), cost(ub, gas, @C_LOAD@) ).

:- trust pred new_obj(X)
   + ( not_fails, is_det, cost(lb, gas, @C_NEW@), cost(ub, gas, @C_NEW@) ).

:- trust pred emit(X)
   + ( not_fails, is_det, cost(lb, gas, @C_EVENT@), cost(ub, gas, @C_EVENT@) ).
